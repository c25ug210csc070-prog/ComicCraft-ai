# Required for Gemini text generation
GEMINI_API_KEY=your_gemini_api_key_here

# Required when IMAGE_PROVIDER=hf
HF_TOKEN=your_huggingface_token_here

# Gemini models. Current defaults are configurable.
GEMINI_OUTLINE_MODEL=gemini-3.8-flash
GEMINI_STORY_MODEL=gemini-3.8-flash

# Image generation: hf (recommended for normal laptops) or local
IMAGE_PROVIDER=hf
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_PROVIDER=auto

# Only used when IMAGE_PROVIDER=local
LOCAL_IMAGE_MODEL=runwayml/stable-diffusion-v1-5
LOCAL_IMAGE_STEPS=20
LOCAL_IMAGE_WIDTH=768
LOCAL_IMAGE_HEIGHT=768

# App settings
PANELS_COUNT=5
MAX_PROMPT_LENGTH=2000

# Development
APP_ENV=development
